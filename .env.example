# Copy this file to .env and fill in your values (the shipped .env already has
# the database settings below filled in).

# Supabase / Lovable Cloud project credentials — these are publishable
# (browser-safe) values, already set in the bundled .env.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Required when running OUTSIDE Lovable (VS Code, your own machine):
# a free Google Gemini API key so AI reconstruction and English translation work.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional: pin a different Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: enables the admin CSV upload page (/admin)
ADMIN_PASSPHRASE=a-strong-admin-passphrase
